<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_pack_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_pack_launcher"
        android:supportsRtl="true">

        <service
            android:name=".SymfoniumIconPackService"
            android:exported="true"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="app.symfonium.intent.action.ICON_PACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="app.symfonium.iconpack.MAP"
                android:resource="@xml/symfonium_icon_pack" />
        </service>
    </application>

</manifest>
